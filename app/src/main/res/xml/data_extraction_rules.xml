<?xml version="1.0" encoding="utf-8"?>
<!-- Device-to-device backup: study data, settings and preferences travel to a
     new phone. Cloud sync (Supabase) handles cross-device merge on restore. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
        <include domain="file" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
        <include domain="file" path="." />
    </device-transfer>
</data-extraction-rules>

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=MY_GEMINI_API_KEY

# Supabase (open-source backend): project URL + anon/publishable key.
# Found in Project Settings -> API. The anon key is public-safe; row-level
# security policies enforce data isolation.
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_ANON_KEY=YOUR_ANON_JWT_OR_PUBLISHABLE_KEY

# Google sign-in: "Web client ID" from Google Cloud Console OAuth client.
# Leave as the placeholder to hide the Google button (email/password still works).
GOOGLE_WEB_CLIENT_ID=YOUR_GOOGLE_WEB_CLIENT_ID

